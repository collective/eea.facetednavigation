include *.md *.rst
graft docs
graft src
global-exclude *pyc
global-exclude *~
global-exclude *.un~
global-include *.mo
exclude .eslintignore
exclude .eslintrc.js
exclude .prettierignore
exclude .prettierrc.json
exclude babel.config.js
exclude instance.yaml
exclude Makefile
exclude package.json
exclude webpack.config.js
exclude yarn.lock
prune resources
prune scripts
