<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="eea"
    >

  <genericsetup:upgradeSteps
      profile="eea.facetednavigation:default"
      source="*"
      destination="16.0"
      >

    <genericsetup:upgradeDepends
        title="Import all steps from eea.facetednavigation default profile"
        import_profile="eea.facetednavigation:default"
        />

  </genericsetup:upgradeSteps>

  <genericsetup:upgradeStep
      title="Load the faceted bundles in order (defer, not async)"
      profile="eea.facetednavigation:default"
      source="16.0"
      destination="16.5"
      handler=".evolve165.disable_async_bundles"
      />

</configure>
