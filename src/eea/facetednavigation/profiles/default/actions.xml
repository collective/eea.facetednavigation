<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Plone Actions Tool"
        name="portal_actions"
>
  <object meta_type="CMF Action Category"
          name="object_buttons"
  >
    <object name="faceted.sync"
            remove="True"
    />
    <object meta_type="CMF Action"
            name="faceted.disable"
            i18n:domain="eea"
    >
      <property name="title"
                i18n:translate=""
      >Disable faceted navigation</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:${object/absolute_url}/@@faceted_subtyper/disable</property>
      <property name="link_target" />
      <property name="icon_expr" />
      <property name="available_expr">object/@@faceted_subtyper/can_disable</property>
      <property name="permissions">
        <element value="eea.facetednavigation: Configure faceted" />
      </property>
      <property name="visible">True</property>
    </object>
    <object meta_type="CMF Action"
            name="faceted.enable"
            i18n:domain="eea"
    >
      <property name="title"
                i18n:translate=""
      >Enable faceted navigation</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:${object/absolute_url}/@@faceted_subtyper/enable</property>
      <property name="link_target" />
      <property name="icon_expr" />
      <property name="available_expr">object/@@faceted_subtyper/can_enable</property>
      <property name="permissions">
        <element value="eea.facetednavigation: Configure faceted" />
      </property>
      <property name="visible">True</property>
    </object>
    <object meta_type="CMF Action"
            name="faceted.search.disable"
            i18n:domain="eea"
    >
      <property name="title"
                i18n:translate=""
      >Disable faceted search</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:${object/absolute_url}/@@faceted_search_subtyper/disable</property>
      <property name="link_target" />
      <property name="icon_expr" />
      <property name="available_expr">object/@@faceted_search_subtyper/can_disable</property>
      <property name="permissions">
        <element value="eea.facetednavigation: Configure faceted" />
      </property>
      <property name="visible">True</property>
    </object>
    <object meta_type="CMF Action"
