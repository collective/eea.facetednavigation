<div class="faceted-widget faceted-range-widget"
     style="display: none"
     data-invalid-range-msg="Invalid range"
     tal:define="
       error_view nocall:context/@@faceted.widget.error;
       wid python:view.data.getId();
       hidden python:view.hidden;
       default_value python:view.default;
       default_start python:default_value[0];
       default_end python:default_value[1];
       integer python:view.integer;
       labelStart python:view.data.get('labelStart', 'Start');
       labelEnd python:view.data.get('labelEnd', 'End');
       placeholderStart python:view.data.get('placeholderStart', '');
       placeholderEnd python:view.data.get('placeholderEnd', '');
       css string:faceted-widget ${view/css_class};
       css python:hidden and css + ' faceted-widget-hidden' or css;
     "
     tal:attributes="
       id string:${wid}_widget;
       class css;
     "
     i18n:attributes="data-invalid-range-msg"
     i18n:domain="eea"
>

  <fieldset class="widget-fieldset">
    <legend tal:define="
              title python:view.data.get('title', '');
            "
            tal:content="
  python:view.translate(title)"
            i18n:translate=""
    >Range widget</legend>

    <form class="faceted-range-widget-form"
          action="."
          method="get"
          tal:on-error="structure python:error_view(error=error, cid=wid)"
    >
      <div tal:attributes="
             id string:${wid}_start;
           ">
        <label class="form-check-label"
               tal:content="python:view.translate(labelStart)"
               tal:attributes="
                 for string:$wid-start-input;
               "
               i18n:translate=""
        >Start</label>
        <input class="form-control"
               name="start"
               title="Start"
               type="text"
               tal:attributes="
                 id string:$wid-start-input;
                 placeholder python:view.translate(placeholderStart);
                 value default_start;
                 type python:'number' if integer else 'text';
               "
               i18n:attributes="title"
        />
      </div>
      <div tal:attributes="
             id string:${wid}_end;
           ">
        <label class="form-check-label"
               tal:content="python:view.translate(labelEnd)"
               tal:attributes="
                 for string:$wid-end-input;
               "
               i18n:translate=""
        >End</label>
        <input class="form-control"
               name="end"
               title="End"
               type="text"
               tal:attributes="
                 id string:$wid-end-input;
                 placeholder python:view.translate(placeholderEnd);
                 value default_end;
                 type python:'number' if integer else 'text';
               "
               i18n:attributes="title"
        />
      </div>
      <div tal:attributes="
             id string:${wid}_errors;
           "></div>
    </form>

  </fieldset>
</div>
